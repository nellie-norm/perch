rules_version = '2';

// Firestore Security Rules for Perch
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ VENUES ============
    // Anyone can read venues (public data)
    // Only admins can write
    match /venues/{venueId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ============ BOOKINGS ============
    // Global bookings collection - for venue operators to see all bookings
    match /bookings/{bookingId} {
      // Anyone can create a booking (guests included)
      allow create: if true;

      // Allow read if: owner, or anyone (for check-in page - booking ref acts as secret)
      allow read: if true;

      // Allow update if: owner (cancel/modify), or venue check-in (status to checked_in)
      allow update: if resource.data.user.uid == request.auth.uid
                    || request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'checkedInAt', 'reviewEmailSent', 'reviewEmailSentAt', 'reviewed', 'reviewedAt']);

      // No deletes - bookings should be cancelled, not deleted
      allow delete: if false;
    }

    // ============ REVIEWS ============
    // Anyone can read reviews, authenticated users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;  // Allow creating reviews from review page
      allow update, delete: if false;  // Reviews can't be edited or deleted
    }

    // ============ USER DATA ============
    match /users/{userId} {
      // Users can only access their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's bookings subcollection
      match /bookings/{bookingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's favourites subcollection
      match /favourites/{favouriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ============ AVAILABILITY ============
    // Slot availability - anyone can read, authenticated users can update
    match /availability/{slotId} {
      allow read: if true;

      // Allow creating new slots when booking
      allow create: if true;

      // Allow incrementing bookedSeats
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['bookedSeats']);
    }

    // ============ DEFAULT DENY ============
    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
